{
  "datasets": [
    {
      "name": "ds_totals",
      "displayName": "Overall totals",
      "queryLines": [
        "SELECT COUNT(*) AS txn_count,\n",
        "       SUM(TRANSACTION_AMOUNT) AS total_amount,\n",
        "       COUNT(DISTINCT CUSTOMER_KEY) AS customer_count,\n",
        "       ROUND(SUM(TRANSACTION_AMOUNT) / COUNT(*), 2) AS avg_txn_value\n",
        "FROM workspace.transactions.silver_transactions\n"
      ]
    },
    {
      "name": "ds_daily",
      "displayName": "Daily spend",
      "queryLines": [
        "SELECT TRANSACTION_DATE, 'Spend (£)' AS series, total_amount\n",
        "FROM workspace.transactions.gold_daily_summary\n",
        "ORDER BY TRANSACTION_DATE\n"
      ]
    },
    {
      "name": "ds_monthly_yoy",
      "displayName": "Monthly spend by year",
      "queryLines": [
        "SELECT concat(lpad(cast(month(TRANSACTION_DATE) AS string), 2, '0'),\n",
        "              ' ', date_format(TRANSACTION_DATE, 'MMM')) AS month_label,\n",
        "       cast(year(TRANSACTION_DATE) AS string) AS yr,\n",
        "       SUM(total_amount) AS total_amount\n",
        "FROM workspace.transactions.gold_daily_summary\n",
        "GROUP BY month_label, yr\n",
        "ORDER BY month_label, yr\n"
      ]
    },
    {
      "name": "ds_eu_share_monthly",
      "displayName": "EU share of spend by month",
      "queryLines": [
        "SELECT date_trunc('MONTH', TRANSACTION_DATE) AS month,\n",
        "       'EU share (%)' AS series,\n",
        "       ROUND(100 * SUM(eu_amount) / SUM(total_amount), 1) AS eu_share_pct\n",
        "FROM workspace.transactions.gold_daily_summary\n",
        "GROUP BY month\n",
        "ORDER BY month\n"
      ]
    },
    {
      "name": "ds_day_of_week",
      "displayName": "Average daily spend by weekday",
      "queryLines": [
        "SELECT concat(weekday(TRANSACTION_DATE) + 1, ' ',\n",
        "              date_format(TRANSACTION_DATE, 'E')) AS weekday_label,\n",
        "       'Avg daily spend (£)' AS series,\n",
        "       ROUND(AVG(total_amount), 2) AS avg_daily_spend\n",
        "FROM workspace.transactions.gold_daily_summary\n",
        "GROUP BY weekday_label\n",
        "ORDER BY weekday_label\n"
      ]
    },
    {
      "name": "ds_atv_monthly",
      "displayName": "Average transaction value by month",
      "queryLines": [
        "SELECT date_trunc('MONTH', TRANSACTION_DATE) AS month,\n",
        "       'Avg txn value (£)' AS series,\n",
        "       ROUND(SUM(total_amount) / SUM(txn_count), 2) AS avg_txn_value\n",
        "FROM workspace.transactions.gold_daily_summary\n",
        "GROUP BY month\n",
        "ORDER BY month\n"
      ]
    },
    {
      "name": "ds_eu_split",
      "displayName": "EU split",
      "queryLines": [
        "SELECT CASE WHEN EU_FLAG THEN 'EU' ELSE 'Non-EU' END AS region,\n",
        "       SUM(total_amount) AS total_amount\n",
        "FROM workspace.transactions.gold_country_summary\n",
        "GROUP BY 1\n"
      ]
    },
    {
      "name": "ds_countries",
      "displayName": "Top countries",
      "queryLines": [
        "SELECT COUNTRY_CODE, 'Transactions' AS series,\n",
        "       SUM(txn_count) AS txn_count, SUM(total_amount) AS total_amount\n",
        "FROM workspace.transactions.gold_country_summary\n",
        "GROUP BY COUNTRY_CODE\n",
        "ORDER BY txn_count DESC\n",
        "LIMIT 10\n"
      ]
    },
    {
      "name": "ds_merchants",
      "displayName": "Merchant share of spend",
      "queryLines": [
        "SELECT DESCRIPTION_TEXT, 'Share of spend (%)' AS series, txn_count, total_amount,\n",
        "       ROUND(100 * total_amount / SUM(total_amount) OVER (), 2) AS spend_share_pct\n",
        "FROM workspace.transactions.gold_merchant_summary\n",
        "ORDER BY total_amount DESC\n",
        "LIMIT 10\n"
      ]
    },
    {
      "name": "ds_segments",
      "displayName": "Spend by age band and gender",
      "queryLines": [
        "SELECT AGE_BAND, GENDER_CODE, SUM(total_amount) AS total_amount\n",
        "FROM workspace.transactions.gold_customer_segments\n",
        "WHERE AGE_BAND IN ('<30','30-39','40-49','50-59','60-69','>=70')\n",
        "GROUP BY AGE_BAND, GENDER_CODE\n",
        "ORDER BY AGE_BAND\n"
      ]
    },
    {
      "name": "ds_spend_per_customer",
      "displayName": "Spend per customer by age band",
      "queryLines": [
        "SELECT AGE_BAND, 'Spend per customer (£)' AS series,\n",
        "       ROUND(SUM(TRANSACTION_AMOUNT) / COUNT(DISTINCT CUSTOMER_KEY), 2)\n",
        "         AS spend_per_customer\n",
        "FROM workspace.transactions.silver_transactions\n",
        "WHERE AGE_BAND IN ('<30','30-39','40-49','50-59','60-69','>=70')\n",
        "GROUP BY AGE_BAND\n",
        "ORDER BY AGE_BAND\n"
      ]
    },
    {
      "name": "ds_customer_type",
      "displayName": "Spend by customer type",
      "queryLines": [
        "SELECT CUSTOMER_TYPE, 'Spend (£)' AS series, SUM(total_amount) AS total_amount\n",
        "FROM workspace.transactions.gold_customer_segments\n",
        "GROUP BY CUSTOMER_TYPE\n",
        "ORDER BY total_amount DESC\n"
      ]
    },
    {
      "name": "ds_run_log",
      "displayName": "Pipeline run log",
      "queryLines": [
        "SELECT run_ts, stage, file_date, rows_in, rows_out, rows_quarantined, notes\n",
        "FROM workspace.transactions.etl_run_log\n",
        "ORDER BY run_ts DESC\n"
      ]
    },
    {
      "name": "ds_dq_issues",
      "displayName": "Data-quality issues",
      "queryLines": [
        "SELECT FILE_DATE, issue, severity, cnt\n",
        "FROM workspace.transactions.gold_dq_summary\n",
        "ORDER BY cnt DESC\n"
      ]
    },
    {
      "name": "ds_quarantine",
      "displayName": "Quarantine count",
      "queryLines": [
        "SELECT COUNT(*) AS quarantined_rows\n",
        "FROM workspace.transactions.quarantine_transactions\n"
      ]
    }
  ],
